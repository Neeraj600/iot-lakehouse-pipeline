# iot-lakehouse-pipeline — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.

# ── Azure Storage ──────────────────────────────────────────────────────────────
ADLS_ACCOUNT_NAME=iotlakehouseadlsprod
ADLS_CONTAINER_NAME=iot-lakehouse
ADLS_TENANT_ID=your-azure-tenant-id-here

# ── Azure Databricks ──────────────────────────────────────────────────────────
DATABRICKS_HOST=https://adb-XXXXXXXXXXXXXXXXX.azuredatabricks.net
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_CLUSTER_ID=XXXX-XXXXXX-XXXXXXXX
DATABRICKS_SQL_WAREHOUSE_ID=XXXXXXXXXXXXXXXX

# ── Azure Data Factory ────────────────────────────────────────────────────────
ADF_RESOURCE_GROUP=iot-lakehouse-rg-prod
ADF_FACTORY_NAME=iot-lakehouse-adf-prod
ADF_SUBSCRIPTION_ID=your-subscription-id-here

# ── Azure Key Vault ───────────────────────────────────────────────────────────
KEY_VAULT_NAME=iot-lakehouse-kv-prod
KEY_VAULT_URI=https://iot-lakehouse-kv-prod.vault.azure.net/

# ── Oracle Source (MES/ERP) ───────────────────────────────────────────────────
ORACLE_HOST=mes-oracle-prod.internal.example.com
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=MESPROD
ORACLE_USERNAME=mes_reader
ORACLE_PASSWORD=secret-loaded-from-key-vault

# ── Azure Synapse ─────────────────────────────────────────────────────────────
SYNAPSE_SERVER=iot-lakehouse-syn-prod.sql.azuresynapse.net
SYNAPSE_DATABASE=gold_warehouse
SYNAPSE_USERNAME=sqladmin

# ── Azure Event Hubs ──────────────────────────────────────────────────────────
EVENT_HUBS_NAMESPACE=iot-lakehouse-evhns-prod
EVENT_HUBS_CONNECTION_STRING=Endpoint=sb://iot-lakehouse-evhns-prod.servicebus.windows.net/;SharedAccessKeyName=...

# ── dbt ───────────────────────────────────────────────────────────────────────
DBT_TARGET=prod          # staging | prod
DBT_THREADS=4

# ── Alerting ──────────────────────────────────────────────────────────────────
ALERT_EMAIL=data-engineering@example.com
SLACK_WEBHOOK_DATA_ENG=https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX

# ── Pipeline config ───────────────────────────────────────────────────────────
BRONZE_RETENTION_DAYS=90
SILVER_Z_ORDER_COLUMNS=machine_id,event_timestamp
GE_MOSTLY_THRESHOLD=0.98
